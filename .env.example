# Chiave API di ocr.space (registrazione gratuita su https://ocr.space/ocrapi)
# Non inserire mai la chiave nel file config.yaml: va tenuta solo qui.
OCR_SPACE_API_KEY=la-tua-chiave-qui

# Applicazione registrata su Microsoft Entra ID (portal.azure.com ->
# "Registrazioni per l'app"): serve a leggere la casella via Microsoft Graph,
# senza Outlook Desktop installato.
MS_CLIENT_ID=id-applicazione-client
MS_CLIENT_SECRET=segreto-client
# Identificativo del tenant; "common" va bene per gli account personali.
MS_TENANT_ID=common
