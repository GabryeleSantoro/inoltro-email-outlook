# Chiave API di ocr.space (registrazione gratuita su https://ocr.space/ocrapi)
# Non inserire mai la chiave nel file config.yaml: va tenuta solo qui.
OCR_SPACE_API_KEY=la-tua-chiave-qui

# Chiave condivisa con Power Automate: il flusso deve inviarla nell'header
# X-API-Key di ogni chiamata. Se resta vuota il controllo e' disattivato
# (accettabile solo in locale: un servizio esposto in rete va sempre protetto).
SERVICE_API_KEY=una-stringa-lunga-e-casuale

# Indirizzo e porta di ascolto (facoltativi: hanno la precedenza su config.yaml).
API_HOST=0.0.0.0
PORT=8000
